module Remit.Test where

import Daml.Script
import DA.Assert
import DA.Optional (isSome, isNone)
import DA.Time
import Remit.Token
import Remit.Compliance
import Remit.Quote
import Remit.Transfer

data Cast = Cast with
  issuer : Party
  provider : Party
  sender : Party
  recipient : Party
  regulator : Party
  outsider : Party

makeCast : Script Cast
makeCast = do
  issuer <- allocateParty "Issuer"
  provider <- allocateParty "Provider"
  sender <- allocateParty "Sender"
  recipient <- allocateParty "Recipient"
  regulator <- allocateParty "Regulator"
  outsider <- allocateParty "Outsider"
  pure Cast with ..

-- Money for the sender, issued by the issuer.
sendFundsFor : Cast -> Decimal -> Script (ContractId Holding)
sendFundsFor c amt = submit c.issuer do
  createCmd Holding with issuer = c.issuer; owner = c.sender; currency = "USD"; amount = amt; viewers = []

-- A quote from the provider to the sender: 83 INR per USD, fee 0.6% (minimum 1.50), valid 10 minutes.
offerQuote : Cast -> Script (ContractId Quote)
offerQuote c = do
  now <- getTime
  submit c.provider do
    createCmd Quote with
      provider = c.provider
      sender = c.sender
      fromCurrency = "USD"
      toCurrency = "INR"
      rate = 83.0
      feeRate = 0.006
      minFee = 1.5
      expiresAt = addRelTime now (minutes 10)

acceptQuote : Cast -> ContractId Quote -> ContractId Holding -> Decimal -> Script (ContractId RemitTransfer)
acceptQuote c q funds amt = do
  now <- getTime
  submit c.sender do
    exerciseCmd q AcceptQuote with
      recipient = c.recipient
      regulator = c.regulator
      sendAmount = amt
      holdingCid = funds
      settleBy = addRelTime now (days 1)

acceptQuoteMustFail : Cast -> ContractId Quote -> ContractId Holding -> Decimal -> Script ()
acceptQuoteMustFail c q funds amt = do
  now <- getTime
  submitMustFail c.sender do
    exerciseCmd q AcceptQuote with
      recipient = c.recipient
      regulator = c.regulator
      sendAmount = amt
      holdingCid = funds
      settleBy = addRelTime now (days 1)

-- Everything needed before a transfer: money, payout funds, a checked identity, and an accepted quote.
data Ready = Ready with
  sendFunds : ContractId Holding
  treasury : ContractId Holding
  attestation : ContractId KycAttestation
  quote : ContractId Quote
  transfer : ContractId RemitTransfer

prepare : Cast -> Decimal -> Script Ready
prepare c limit = do
  now <- getTime
  sendFunds <- sendFundsFor c 1200.0
  treasury <- submit c.issuer do
    createCmd Holding with issuer = c.issuer; owner = c.provider; currency = "INR"; amount = 1000000.0; viewers = []
  attestation <- submit c.provider do
    createCmd KycAttestation with
      provider = c.provider
      subject = c.sender
      regulator = c.regulator
      limitCurrency = "USD"
      perTransferLimit = limit
      validUntil = addRelTime now (days 30)
  quote <- offerQuote c
  transfer <- acceptQuote c quote sendFunds 500.0
  pure Ready with ..

-- ---------------------------------------------------------------------------
-- Original tests
-- ---------------------------------------------------------------------------

-- 500 USD, fee 3.00, rate 83 => recipient gets (500 - 3) * 83 = 41251.00 INR.
testHappyPath : Script ()
testHappyPath = do
  c <- makeCast
  r <- prepare c 2000.0
  (paid, receipt) <- submit c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury

  Some money <- queryContractId c.recipient paid
  money.amount === 41251.0
  money.currency === "INR"

  Some rec <- queryContractId c.regulator receipt
  rec.fee === 3.0
  rec.sendAmount === 500.0
  pure ()

testOverLimitFails : Script ()
testOverLimitFails = do
  c <- makeCast
  r <- prepare c 100.0
  submitMustFail c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury

testRejectRefundsSender : Script ()
testRejectRefundsSender = do
  c <- makeCast
  r <- prepare c 2000.0
  refunded <- submit c.provider do exerciseCmd r.transfer Reject
  Some back <- queryContractId c.sender refunded
  back.amount === 500.0
  back.currency === "USD"

testPrivacy : Script ()
testPrivacy = do
  c <- makeCast
  r <- prepare c 2000.0
  hidden <- queryContractId c.outsider r.transfer
  assertMsg "An outsider must not see the transfer" (isNone hidden)
  seenByRegulator <- queryContractId c.regulator r.transfer
  assertMsg "The regulator must see the transfer" (isSome seenByRegulator)
  seenByRecipient <- queryContractId c.recipient r.transfer
  assertMsg "The recipient must see the transfer" (isSome seenByRecipient)

testSenderCannotCancelEarly : Script ()
testSenderCannotCancelEarly = do
  c <- makeCast
  r <- prepare c 2000.0
  submitMustFail c.sender do exerciseCmd r.transfer CancelAfterDeadline

-- ---------------------------------------------------------------------------
-- Token: Split and MoveTo
-- ---------------------------------------------------------------------------

testSplitAndMove : Script ()
testSplitAndMove = do
  c <- makeCast
  h <- sendFundsFor c 100.0
  (part, rest) <- submit c.sender do exerciseCmd h Split with splitAmount = 30.0
  Some p <- queryContractId c.sender part
  Some q <- queryContractId c.sender rest
  p.amount === 30.0
  q.amount === 70.0
  moved <- submit c.sender do exerciseCmd part MoveTo with newOwner = c.recipient
  Some m <- queryContractId c.recipient moved
  m.owner === c.recipient
  m.amount === 30.0

testSplitTooLargeFails : Script ()
testSplitTooLargeFails = do
  c <- makeCast
  h <- sendFundsFor c 100.0
  submitMustFail c.sender do exerciseCmd h Split with splitAmount = 100.0
  submitMustFail c.sender do exerciseCmd h Split with splitAmount = 0.0
  submitMustFail c.sender do exerciseCmd h Split with splitAmount = 250.0

-- ---------------------------------------------------------------------------
-- Quote: Decline, expiry, and the checks inside AcceptQuote
-- ---------------------------------------------------------------------------

testDeclineQuote : Script ()
testDeclineQuote = do
  c <- makeCast
  q <- offerQuote c
  submit c.sender do exerciseCmd q Decline
  gone <- queryContractId c.sender q
  assertMsg "A declined quote must be gone" (isNone gone)

testExpiredQuoteFails : Script ()
testExpiredQuoteFails = do
  c <- makeCast
  funds <- sendFundsFor c 1200.0
  q <- offerQuote c
  passTime (minutes 11)
  acceptQuoteMustFail c q funds 500.0

testQuoteAboveBalanceFails : Script ()
testQuoteAboveBalanceFails = do
  c <- makeCast
  funds <- sendFundsFor c 1200.0
  q <- offerQuote c
  acceptQuoteMustFail c q funds 5000.0

testAmountBelowFeeFails : Script ()
testAmountBelowFeeFails = do
  c <- makeCast
  funds <- sendFundsFor c 1200.0
  q <- offerQuote c
  -- The minimum fee is 1.50, so 1.00 cannot cover it.
  acceptQuoteMustFail c q funds 1.0

testOtherPartyCannotAcceptQuote : Script ()
testOtherPartyCannotAcceptQuote = do
  c <- makeCast
  funds <- sendFundsFor c 1200.0
  q <- offerQuote c
  now <- getTime
  submitMustFail c.outsider do
    exerciseCmd q AcceptQuote with
      recipient = c.recipient
      regulator = c.regulator
      sendAmount = 500.0
      holdingCid = funds
      settleBy = addRelTime now (days 1)

-- ---------------------------------------------------------------------------
-- Compliance: expired and revoked identity checks
-- ---------------------------------------------------------------------------

testExpiredAttestationFails : Script ()
testExpiredAttestationFails = do
  c <- makeCast
  r <- prepare c 2000.0
  passTime (days 31)
  submitMustFail c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury

testRevokedAttestationFails : Script ()
testRevokedAttestationFails = do
  c <- makeCast
  r <- prepare c 2000.0
  submit c.provider do exerciseCmd r.attestation Revoke
  submitMustFail c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury

-- ---------------------------------------------------------------------------
-- Transfer: payout funds, cancellation, who may settle, and the receipt
-- ---------------------------------------------------------------------------

testSmallPayoutFundsFail : Script ()
testSmallPayoutFundsFail = do
  c <- makeCast
  r <- prepare c 2000.0
  small <- submit c.issuer do
    createCmd Holding with issuer = c.issuer; owner = c.provider; currency = "INR"; amount = 100.0; viewers = []
  submitMustFail c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = small

testWrongPayoutCurrencyFails : Script ()
testWrongPayoutCurrencyFails = do
  c <- makeCast
  r <- prepare c 2000.0
  euros <- submit c.issuer do
    createCmd Holding with issuer = c.issuer; owner = c.provider; currency = "EUR"; amount = 1000000.0; viewers = []
  submitMustFail c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = euros

-- Payout funds that exactly match the amount owed (no split needed).
testExactPayoutFunds : Script ()
testExactPayoutFunds = do
  c <- makeCast
  r <- prepare c 2000.0
  exact <- submit c.issuer do
    createCmd Holding with issuer = c.issuer; owner = c.provider; currency = "INR"; amount = 41251.0; viewers = []
  (paid, _) <- submit c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = exact
  Some m <- queryContractId c.recipient paid
  m.amount === 41251.0

testCancelAfterDeadlineRefunds : Script ()
testCancelAfterDeadlineRefunds = do
  c <- makeCast
  r <- prepare c 2000.0
  passTime (days 2)
  refunded <- submit c.sender do exerciseCmd r.transfer CancelAfterDeadline
  Some back <- queryContractId c.sender refunded
  back.amount === 500.0
  back.owner === c.sender

testOnlyProviderCanSettle : Script ()
testOnlyProviderCanSettle = do
  c <- makeCast
  r <- prepare c 2000.0
  submitMustFail c.recipient do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury
  submitMustFail c.sender do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury

testReceiptVisibility : Script ()
testReceiptVisibility = do
  c <- makeCast
  r <- prepare c 2000.0
  (_, receipt) <- submit c.provider do
    exerciseCmd r.transfer Settle with attestationCid = r.attestation; payoutCid = r.treasury
  hidden <- queryContractId c.outsider receipt
  assertMsg "An outsider must not see the receipt" (isNone hidden)
  forSender <- queryContractId c.sender receipt
  assertMsg "The sender must see the receipt" (isSome forSender)
  forRecipient <- queryContractId c.recipient receipt
  assertMsg "The recipient must see the receipt" (isSome forRecipient)
  forRegulator <- queryContractId c.regulator receipt
  assertMsg "The regulator must see the receipt" (isSome forRegulator)
